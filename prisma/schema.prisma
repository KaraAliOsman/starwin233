generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  apertura    String
  vidrio      String
  color       String
  camara      Int
  perfileria  String
  uValue      String
  rw          String
  priceGuide  String
  createdAt   DateTime @default(now())
}

model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  date        DateTime
  category    String
  readingTime String
  cover       String
  createdAt   DateTime @default(now())
}
